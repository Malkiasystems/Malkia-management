{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "malkiamaternity.co.tz"
        }
      ],
      "destination": "https://www.malkia.co.tz/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.malkiamaternity.co.tz"
        }
      ],
      "destination": "https://www.malkia.co.tz/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/guide-pdf.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}